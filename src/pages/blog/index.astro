---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="无色之蓝" description="学术随笔" locale="zh-CN">
  <h1>无色之蓝</h1>

  <p style="color: var(--color-text-light); margin-bottom: 2rem;">
    我蓝色的逃逸线，不总是关于学术。
  </p>

  <ul class="section-list">
    <li>
      <div class="item-header">
        <span class="item-title">
          <a href={`${base}blog/sha-bao`}>沙堡</a>
        </span>
        <span class="item-meta">2026-05-11</span>
      </div>
      <div class="item-desc">节选自《皮格马利翁》，关于Aria、海潮和时间。</div>
      <div>
        <span class="tag">长河</span>
      </div>
    </li>
    <li>
      <div class="item-header">
        <span class="item-title">
          <a href={`${base}blog/die-meng-1`}>蝶梦（一）</a>
        </span>
        <span class="item-meta">2026-05-11</span>
      </div>
      <div class="item-desc">栩栩然蝴蝶也。</div>
      <div>
        <span class="tag">长河</span>
      </div>
    </li>
  </ul>
</Layout>
