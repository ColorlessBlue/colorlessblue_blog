---
import Layout from '../layouts/Layout.astro';
---

<Layout title="教育背景 | 杨井璨" description="教育背景" locale="zh-CN">
  <h1>教育背景</h1>

  <ul class="section-list">
    <li>
      <div class="item-header">
        <span class="item-title">文学博士 (PhD in Linguistics)</span>
        <span class="item-meta">2025/09 — 至今</span>
      </div>
      <div class="item-subtitle">浙江大学 &middot; 导师：程工教授</div>
      <div class="item-desc">专业：外国语言学及应用语言学。研究方向：名词性短语内论元结构及名物化。</div>
    </li>

    <li>
      <div class="item-header">
        <span class="item-title">文学硕士 (MA in Language Studies)</span>
        <span class="item-meta">2024/09 — 2025/06</span>
      </div>
      <div class="item-subtitle">香港城市大学 &middot; 学位等级优异 (with distinction)</div>
      <div class="item-desc">专业：语言研究（普通语言学）。GPA: 3.59 / 4.00</div>
    </li>

    <li>
      <div class="item-header">
        <span class="item-title">文学学士 (BA in Chinese International Education)</span>
        <span class="item-meta">2020/09 — 2024/06</span>
      </div>
      <div class="item-subtitle">首都师范大学 &middot; 完成荣誉课程项目</div>
      <div class="item-desc">专业：汉语国际教育。GPA: 4.01 / 5.00（百分制：90.1 / 100）</div>
    </li>
  </ul>

  <h2>暑期学校</h2>
  <ul class="section-list">
    <li>
      <div class="item-header">
        <span class="item-title">中国语言学书院儿童语言习得高级研讨班</span>
        <span class="item-meta">2025/07 — 2025/08</span>
      </div>
    </li>
    <li>
      <div class="item-header">
        <span class="item-title">中国语言学书院核心研讨班</span>
        <span class="item-meta">2024/07 — 2024/08</span>
      </div>
      <div class="item-desc">获优秀学员奖</div>
    </li>
  </ul>
</Layout>
