---
import Layout from '../../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Colorless Blue" description="Academic writings" locale="en">
  <h1>Colorless Blue</h1>

  <p style="color: var(--color-text-light); margin-bottom: 2rem;">
    My blue line of flight, not always about academia.
  </p>

  <ul class="section-list">
    <li>
      <div class="item-header">
        <span class="item-title">
          <a href={`${base}en/blog/a-note`}>A Note on the Untranslatable</a>
        </span>
        <span class="item-meta">2026-08-15</span>
      </div>
      <div class="item-desc">Why my literary writing has no English version</div>
      <div>
        <span class="tag">note</span>
      </div>
    </li>
  </ul>
</Layout>
