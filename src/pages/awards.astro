---
import Layout from '../layouts/Layout.astro';
---

<Layout title="荣誉 | 杨井璨" description="获奖与荣誉" locale="zh-CN">
  <h1>荣誉</h1>

  <ul class="section-list">
    <li>
      <div class="item-header">
        <span class="item-title">首都师范大学实验室开放基金优秀项目</span>
        <span class="item-meta">2023</span>
      </div>
      <div class="item-subtitle">首都师范大学 &middot; 项目参与者</div>
      <div class="item-desc">项目名称：上古汉语阴阳入对转研究</div>
    </li>

    <li>
      <div class="item-header">
        <span class="item-title">首都师范大学综合素质提升科研立项一等奖</span>
        <span class="item-meta">2022</span>
      </div>
      <div class="item-subtitle">首都师范大学 &middot; 项目负责人</div>
      <div class="item-desc">项目名称：基于深度学习的社交平台语料库分析</div>
    </li>

    <li>
      <div class="item-header">
        <span class="item-title">首都师范大学学业优秀奖学金</span>
        <span class="item-meta">2022, 2023</span>
      </div>
    </li>
  </ul>
</Layout>
