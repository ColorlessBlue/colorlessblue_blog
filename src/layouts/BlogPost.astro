---
import Layout from './Layout.astro';

interface Frontmatter {
  title: string;
  date?: string;
  description?: string;
  prev?: { title: string; url: string };
  next?: { title: string; url: string };
}

const base = import.meta.env.BASE_URL;
const { title, date, description, prev, next } = Astro.props.frontmatter as Frontmatter;
---

<Layout title={`${title} — 无色之蓝`} description={description || title} locale="zh-CN">
  <a href={`${base}blog`} class="post-back">&larr; 返回列表</a>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      {date && (
        <time class="post-date" datetime={date}>
          {new Date(date).toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      )}
      <div class="post-divider"></div>
      {description && <p class="post-description">{description}</p>}
    </header>
    <div class="post-body">
      <slot />
    </div>
  </article>

  <nav class="post-nav">
    <span class="post-nav-item post-nav-prev">
      {prev && <a href={`${base}${prev.url.replace(/^\//, '')}`}>&larr; {prev.title}</a>}
    </span>
    <span class="post-nav-item post-nav-center">
      <a href={`${base}blog`}>返回列表</a>
    </span>
    <span class="post-nav-item post-nav-next">
      {next && <a href={`${base}${next.url.replace(/^\//, '')}`}>{next.title} &rarr;</a>}
    </span>
  </nav>
</Layout>

<style>
  .post-header {
    margin-bottom: 2.5rem;
  }

  .post-back {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-text-light);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color 0.15s ease;
  }

  .post-back:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.03em;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .post-date {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin-bottom: 1.25rem;
  }

  .post-divider {
    width: 40%;
    border-top: 1px solid var(--color-border);
    margin-bottom: 1.25rem;
  }

  .post-description {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .post-body {
    font-size: 1rem;
    line-height: 1.85;
  }

  .post-body :global(p) {
    text-indent: 2em;
    margin-bottom: 1rem;
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }

  .post-nav-item {
    flex: 1;
  }

  .post-nav-center {
    text-align: center;
  }

  .post-nav-next {
    text-align: right;
  }

  .post-nav a {
    color: var(--color-text-light);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .post-nav a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .post-title {
      font-size: 1.8rem;
    }

    .post-nav {
      gap: 0.4rem;
      font-size: 0.82rem;
    }

    .post-nav-item {
      flex: 1;
      min-width: 0;
    }

    .post-nav a {
      overflow-wrap: break-word;
    }
  }
</style>
